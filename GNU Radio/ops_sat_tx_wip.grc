  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [856, 480.0]
    rotation: 0
    state: enabled
- name: csp_priority
  id: variable
  parameters:
    comment: Default with src/dst/ports gives header CA A7 C0 00
    value: '3'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [592, 480.0]
    rotation: 0
    state: enabled
- name: csp_sport
