options:
  parameters:
    author: Kevin Wu
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: OPS-SAT TX chain divided into GNU Radio DSP blocks. Imports ops_sat_framing.py
      for CSP + OPS-SAT framing bits.
    gen_cmake: 'Off'
    gen_linking: dynamic
    generate_options: no_gui
    hier_block_src_path: '.:'
    id: ops_sat_tx_wip
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: OPS-SAT TX (WIP)
    window_size: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: amplitude
  id: variable
  parameters:
    comment: ''
    value: '0.25'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [392, 312]
    rotation: 0
    state: enabled
- name: baseband_rate
  id: variable
  parameters:
    comment: ''
    value: baud*sps
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 312]
    rotation: 0
    state: enabled
- name: baud
  id: variable
  parameters:
    comment: ''
    value: '9600'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 184]
    rotation: 0
    state: enabled
- name: bt
  id: variable
  parameters:
    comment: ''
    value: '0.5'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [392, 120]
    rotation: 0
    state: enabled
- name: csp_crc32c
  id: variable
  parameters:
    comment: False matches your original flags=0 packets; True appends CRC32C and
      sets flag bit
    value: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [856, 552.0]
    rotation: 0
    state: enabled
- name: csp_crc_include_header
  id: variable
  parameters:
    comment: 'For libcsp v1 style CRC, usually False: CRC over CSP data, not header'
    value: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [856, 624.0]
    rotation: 0
    state: enabled
- name: csp_data_hex
  id: variable
  parameters:
    comment: Optional CSP data bytes after the 4-byte header; leave empty for demo
      data
    value: '""'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [592, 400.0]
    rotation: 0
    state: enabled
- name: csp_data_text
  id: variable
  parameters:
    comment: None uses built-in binary demo data; set to a string for ASCII CSP data
    value: None
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [592, 320.0]
    rotation: 0
    state: enabled
- name: csp_dport
  id: variable
  parameters:
    comment: CSP destination port
    value: '31'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [856, 320.0]
    rotation: 0
    state: enabled
- name: csp_dst
